# FisioFlow - Configurações de Ambiente

# Flask Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=fisioflow-secret-key-development-2024

# Database Configuration (SQLite para desenvolvimento)
DATABASE_URL=sqlite:///fisioflow.db
SQLALCHEMY_DATABASE_URI=sqlite:///fisioflow.db
SQLALCHEMY_TRACK_MODIFICATIONS=False

# JWT Configuration
JWT_SECRET_KEY=jwt-secret-fisioflow-2024
JWT_ACCESS_TOKEN_EXPIRES=86400

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Email Configuration (para futuro)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=

# Redis Configuration (para cache - opcional por enquanto)
REDIS_URL=redis://localhost:6379/0

# API Keys (para futuro)
OPENAI_API_KEY=
GOOGLE_API_KEY=
WHATSAPP_API_KEY=

# Payment Configuration (para futuro)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/fisioflow.log

# Feature Flags
ENABLE_AI_FEATURES=False
ENABLE_PAYMENTS=False
ENABLE_WHATSAPP=False

